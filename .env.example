# ==================================================
# SMART COLLEGE BUS TRACKING SYSTEM - ENVIRONMENT CONFIG
# ==================================================

# 1. Google Maps JavaScript API Key
# Obtain an API key from Google Cloud Console with Maps JavaScript API enabled.
# If omitted or left blank, the application automatically enters DEMO MAP MODE.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. Backend REST API & Real-time Socket URL
# Points to Node.js / Express backend server port
VITE_API_URL=http://localhost:5000

# 3. Supabase Configuration (Optional - PostgreSQL Integration)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server Port
PORT=5000
