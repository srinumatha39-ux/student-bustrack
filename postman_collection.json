            "url": {
              "raw": "{{baseUrl}}/api/buses/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buses", ":id"],
              "variable": [{ "key": "id", "value": "b1" }]
            }
          }
        }
