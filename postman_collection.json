        {
          "name": "Add Bus Vehicle & Route",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bus_number\": \"AP-31-9999\",\n  \"bus_name\": \"Express Shuttle\",\n  \"route_name\": \"Anakapalle -> Campus\",\n  \"start_point\": \"Anakapalle\",\n  \"destination\": \"College Gate\",\n  \"estimated_time\": 45,\n  \"college_id\": \"STMARYS\",\n  \"stops\": [\n    { \"id\": \"st1\", \"stop_name\": \"Ring Road\", \"latitude\": 17.6896, \"longitude\": 83.0024, \"stop_order\": 1 },\n    { \"id\": \"st2\", \"stop_name\": \"College Gate\", \"latitude\": 17.7342, \"longitude\": 83.0780, \"stop_order\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/buses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buses"]
            }
          }
        },
